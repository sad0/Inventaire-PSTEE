
menu
{
	name 'INVENTORY'
	align center center
	ignoreEsc
	size 1024 768
	greyscale lua "characters[id].HP.current <= 0"
	interactable lua "characters[id].HP.current > 0"
	onOpen
	"
		Infinity_ActivateInventory()
		pushSidebars()
		doubleClickEventScheduled = nil
		Infinity_SetBackground('BACKGROUND_INVENTORY')
		psInvApplyPositions()
		if PSC_AutoTest then PSC_AutoTest() end
		if PSUI_Refresh then PSUI_Refresh() end
	"
	onClose
	"
		popSidebars()
		Infinity_SetBackground(nil)
	"
	button
	{
		area 263 163 121 172
		paperdoll 1
		actiondrag "Infinity_SwapWithAppearance()"
	}
	label
	{
		name "psinv_name"
		area 104 73 104 24
		text lua "characters[id].name"
		text style "label"
		text font "EXOCET"
		text point 13
		text color lua "psInvYellow()"
	}
	label
	{
		name "psinv_class"
		area 276 74 95 24
		text lua "characters[id].class"
		text style "label"
		text font "EXOCET"
		text point 13
		text color lua "psInvYellow()"
	}
